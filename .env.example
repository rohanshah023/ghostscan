# Copy to .env and export before starting (or use your host's environment settings).
GHOSTSCAN_TRUST_PROXY=1            # 1 when nginx/Cloudflare tunnel is in front, else 0
GHOSTSCAN_MAX_BYTES=10485760       # upload limit
GHOSTSCAN_MAX_CONCURRENT=2         # simultaneous analyses per server process
GHOSTSCAN_QUEUE_WAIT_S=20          # how long a request waits for a free slot before "busy"
GHOSTSCAN_RATE_LIMIT=30            # POST requests per client IP per window, per process
GHOSTSCAN_RATE_WINDOW_S=60
GHOSTSCAN_TIMEOUT=20               # seconds per analysed file
GHOSTSCAN_MAX_PIXELS=16000000      # largest decoded image (a small file can hide a huge image)
GHOSTSCAN_CACHE_TTL_S=600          # identical files are not analysed twice within this time
# GHOSTSCAN_CLAMD_HOST=clamav      # ClamAV daemon (fast). Or GHOSTSCAN_CLAMD_SOCKET=/run/clamav/clamd.ctl
# GHOSTSCAN_VT_API_KEY=            # VirusTotal hash lookup (hash only, never the file)
# GHOSTSCAN_ALLOW_DOWNLOAD=1       # scan links by downloading the file (SSRF-guarded, no redirects)
WEB_CONCURRENCY=3                  # gunicorn worker processes
HOST=0.0.0.0
PORT=8000
